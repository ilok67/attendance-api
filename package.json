{
  "name": "attendance-api",
  "version": "1.0.0",
  "description": "Multi-school elementary attendance system API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "tsx scripts/seed.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "5.22.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.1",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
